PORT=5000

# MongoDB connection string. Use Atlas in production.
# IMPORTANT: rotate any password that has been shared in chat or commits.
MONGODB_URI=mongodb+srv://USER:PASS@cluster0.xxxx.mongodb.net/textile_db?retryWrites=true&w=majority

# JWT secret — REPLACE with a long random string in production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_me_with_a_long_random_string_at_least_32_chars

# Token expiry. Default 7d. Use shorter (e.g. 1h) for stricter security.
JWT_EXPIRES_IN=7d

# Optional: comma-separated list of allowed CORS origins.
# If unset, CORS is wide open (development only).
# CORS_ORIGINS=https://your-frontend.com,https://app.your-domain.com
